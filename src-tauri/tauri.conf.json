{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clover RP",
  "version": "1.41.0",
  "identifier": "com.lopezzkk.cloverrp",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clover RP",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Clover RP",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["PortugueseBR"], "installMode": "currentUser" }
    }
  }
}
